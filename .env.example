# Copy to .env and fill in values. Never commit real secrets.

# --- Chat (Google Gemini — free tier via AI Studio) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Also accepted: GOOGLE_API_KEY (same value)
DOCUBOT_LLM_PROVIDER=gemini
# Chat model: free-tier quotas are per-model. flash-lite is often capped very low (e.g. ~20/day).
# If you see 429 RESOURCE_EXHAUSTED, switch model or enable billing — see AI Studio → Models.
DOCUBOT_CHAT_MODEL=gemini-2.5-flash
# Cheaper / faster when quota allows: gemini-2.5-flash-lite  |  Alternatives: gemini-2.0-flash

# fast = one retrieval + one Gemini call (default when unset + Gemini — saves free-tier quota).
# full = LangGraph planner / retriever / grader / replan (3+ API calls per question; needs quota/billing).
DOCUBOT_AGENT_MODE=fast

# --- Embeddings (OpenAI per project direction) ---
OPENAI_API_KEY=

DOCUBOT_EMBEDDING_PROVIDER=openai
DOCUBOT_EMBEDDING_MODEL=text-embedding-3-small

# Optional: OpenAI chat instead of Gemini
# DOCUBOT_LLM_PROVIDER=openai
# DOCUBOT_CHAT_MODEL=gpt-4o-mini

# Optional: Ollama (local chat)
# DOCUBOT_LLM_PROVIDER=ollama
# DOCUBOT_OLLAMA_BASE_URL=http://localhost:11434/v1
# DOCUBOT_CHAT_MODEL=llama3.2

# --- Web search (real HTTP integration; default DuckDuckGo, no API key) ---
# DOCUBOT_WEB_SEARCH_BACKEND=duckduckgo
# Optional production backend (requires TAVILY_API_KEY):
# DOCUBOT_WEB_SEARCH_BACKEND=tavily
# TAVILY_API_KEY=

# Chroma persistence (use a volume path in Docker/Kubernetes)
DOCUBOT_CHROMA_PATH=./vector_db

DOCUBOT_PII_REDACTION_ENABLED=true

# Timeouts (seconds) — avoid a hung UI if an API stalls
# DOCUBOT_LLM_TIMEOUT_SEC=120
# Full LangGraph wall clock (default 900). Raise if you still hit timeouts on slow networks or retries.
# DOCUBOT_GRAPH_TIMEOUT_SEC=900
# DOCUBOT_FAST_TIMEOUT_SEC=180
# Max lines in the Sources section under each answer (top retrieval scores; default 3)
# DOCUBOT_MAX_SOURCES_DISPLAY=3
# Chunks to retrieve per question (default 8; lower = slightly faster / shorter context)
# DOCUBOT_RETRIEVER_K=8
# DOCUBOT_WEB_SEARCH_TIMEOUT_SEC=25
# Retries when Gemini returns 429 / RESOURCE_EXHAUSTED (waits for API "retry in Ns" when present)
# DOCUBOT_LLM_RETRY_ATTEMPTS=5

# Streamlit (used in Docker / platforms that set PORT)
# STREAMLIT_SERVER_PORT=8501
