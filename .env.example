# Copy to `.env` and fill in secret values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Required (typical setup: Gemini chat + OpenAI embeddings)
# -----------------------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Same value as GEMINI_API_KEY if you prefer this name:
# GOOGLE_API_KEY=

# Required for indexing and hybrid RAG (embeddings):
OPENAI_API_KEY=

# App data on disk: SQLite users DB + per-user Chroma under users/<id>/chroma/
# Local: default below. For `docker run --env-file .env`, that file OVERRIDES the image, so also pass
#   -e DOCUBOT_DATA_DIR=/data
# and mount  -v docubot_data:/data  (or use docker-compose.yml, which sets /data for you).
DOCUBOT_DATA_DIR=.docubot

# -----------------------------------------------------------------------------
# LLM & embeddings (defaults work for most users)
# -----------------------------------------------------------------------------
DOCUBOT_LLM_PROVIDER=gemini
DOCUBOT_CHAT_MODEL=gemini-2.5-flash
DOCUBOT_EMBEDDING_PROVIDER=openai
DOCUBOT_EMBEDDING_MODEL=text-embedding-3-small

# OpenAI chat instead of Gemini:
# DOCUBOT_LLM_PROVIDER=openai
# DOCUBOT_CHAT_MODEL=gpt-4o-mini

# Ollama (local):
# DOCUBOT_LLM_PROVIDER=ollama
# DOCUBOT_OLLAMA_BASE_URL=http://localhost:11434/v1
# DOCUBOT_CHAT_MODEL=llama3.2
# OLLAMA_API_KEY=ollama

# Local embeddings (optional; only if DOCUBOT_EMBEDDING_PROVIDER=local):
# DOCUBOT_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Web search (agent tool)
# -----------------------------------------------------------------------------
# DOCUBOT_WEB_SEARCH_BACKEND=duckduckgo
# DOCUBOT_WEB_SEARCH_BACKEND=tavily
# TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Pipeline & retrieval
# -----------------------------------------------------------------------------
DOCUBOT_PII_REDACTION_ENABLED=true
# DOCUBOT_MAX_SOURCES_DISPLAY=3
# DOCUBOT_RETRIEVER_K=8

# -----------------------------------------------------------------------------
# Timeouts & retries
# -----------------------------------------------------------------------------
# DOCUBOT_LLM_TIMEOUT_SEC=120
# DOCUBOT_GRAPH_TIMEOUT_SEC=900
# DOCUBOT_WEB_SEARCH_TIMEOUT_SEC=25
# DOCUBOT_LLM_RETRY_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Streamlit / Docker (port is read by the Streamlit CLI, not config.py)
# -----------------------------------------------------------------------------
# PORT=8501
# STREAMLIT_SERVER_PORT=8501
# Public URL for links in emails (no trailing slash). Must match the URL users use in production.
# DOCUBOT_PUBLIC_URL=https://your-app.example

# Outgoing mail for sign-up verification and password reset. If unset, verification and reset links
# are shown on the sign-in / registration page instead.
# DOCUBOT_SMTP_HOST=
# DOCUBOT_SMTP_PORT=587
# DOCUBOT_SMTP_USER=
# DOCUBOT_SMTP_PASSWORD=
# DOCUBOT_SMTP_FROM=
# DOCUBOT_SMTP_USE_TLS=1

# Optional: secret for signed “stay signed in” browser cookies (set in production / multi-server).
# If unset, a key is derived from DOCUBOT_DATA_DIR (ok for one machine).
# DOCUBOT_SESSION_SECRET=
